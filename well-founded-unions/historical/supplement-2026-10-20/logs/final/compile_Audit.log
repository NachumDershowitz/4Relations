least_rank_is_nonzero_limit
     : forall (A B C D : rel ?X) (J : ?X -> Prop),
       WF A ->
       WF C ->
       WF D ->
       P0 A B C D ->
       Q2 B C D ->
       (forall x y : ?X, R0 A B C D x y -> J x /\ J y) ->
       (forall x : ?X, J x -> exists y : ?X, R0 A B C D x y) ->
       forall (K : Type) (ltK : K -> K -> Prop) (rho : ?X -> K),
       (forall u : K, ~ ltK u u) ->
       (forall u v w : K, ltK u v -> ltK v w -> ltK u w) ->
       (forall u v : K, u = v \/ ltK u v \/ ltK v u) ->
       (forall x y : ?X, B x y -> ltK (rho y) (rho x)) ->
       (forall (x : ?X) (alpha : K),
        (forall y : ?X, B x y -> ltK (rho y) alpha) ->
        rho x = alpha \/ ltK (rho x) alpha) ->
       (forall x y z : ?X,
        F0 C D x y ->
        B y z ->
        (exists u : ?X, A x u /\ star (R0 A B C D) u z) \/ plus B x z) ->
       forall alpha : K,
       (exists x : ?X, M A J x /\ rho x = alpha) ->
       (forall x : ?X, M A J x -> alpha = rho x \/ ltK alpha (rho x)) ->
       (exists beta : K, ltK beta alpha) /\
       (forall beta : K,
        ltK beta alpha -> exists gamma : K, ltK beta gamma /\ ltK gamma alpha)
where
?X : [ |- Type]
