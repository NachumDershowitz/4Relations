audited_expanded_finite_statement
     : forall (X : Type) (A B C D : X -> X -> Prop),
       well_founded (fun y x : X => A x y) ->
       well_founded (fun y x : X => B x y) ->
       well_founded (fun y x : X => C x y) ->
       well_founded (fun y x : X => D x y) ->
       (forall x y z : X,
        B x y \/ C x y \/ D x y ->
        A y z ->
        (exists u : X, A x u /\ star (fun s t : X => A s t \/ B s t \/ C s t \/ D s t) u z) \/
        B x z \/ C x z \/ D x z) ->
       (forall x y z : X,
        C x y \/ D x y ->
        B y z ->
        (exists u : X, A x u /\ star (fun s t : X => A s t \/ B s t \/ C s t \/ D s t) u z) \/
        (exists u : X, B x u /\ star B u z) \/ C x z \/ D x z) ->
       (forall x y z : X,
        D x y ->
        C y z ->
        (exists u : X, B x u /\ star (fun s t : X => B s t \/ C s t \/ D s t) u z) \/
        (exists u : X, C x u /\ star C u z) \/ D x z) ->
       (exists l : list X, forall x : X, List.In x l) ->
       well_founded (fun y x : X => A x y \/ B x y \/ C x y \/ D x y)
