       WF C ->
       WF D ->
       P0 A B C D ->
       P1 A B C D ->
       Q2 B C D ->
       (exists x : X, S x) ->
       (exists l : list X, forall x z : X, S x -> B x z -> bad (R0 A B C D) z -> List.In z l) ->
       False
