     : forall (X : Type) (A B C D : rel X) (S : X -> Prop),
       (forall x : X, S x -> minimal_immortal A B C D x) ->
       (forall z : X,
        bad (R0 A B C D) z ->
        exists t : X, S t /\ (forall x : X, S x -> E0 B C D x z -> E0 B C D x t)) ->
       WF A ->
